# Dockerfile.replay builds bmp-replay for docker-compose.dev.yml. It is
# deliberately absent from `make images`: bmp-replay is dev-stack scaffolding
# that feeds a collector you control, not something to publish to a registry
# alongside the three daemons.
FROM golang:1.27@sha256:957861185dbf29d93668ace41e011d091c6e779953d47f0316ef2cc58e28fe2b AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# .dockerignore keeps .git out of the context, so the version cannot be read
# here; pass VERSION and REVISION as build args to stamp the binary.
ARG VERSION=dev
ARG REVISION=unknown
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X github.com/jp2195/vantage/buildinfo.Version=${VERSION} -X github.com/jp2195/vantage/buildinfo.Revision=${REVISION}" -o /out/bmp-replay ./cmd/bmp-replay

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/bmp-replay /bmp-replay
ENTRYPOINT ["/bmp-replay"]
