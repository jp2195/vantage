# Dockerfile.replay builds bmp-replay for docker-compose.dev.yml. It is
# deliberately absent from `make images`: bmp-replay is dev-stack scaffolding
# that feeds a collector you control, not something to publish to a registry
# alongside the three daemons.
FROM golang:1.27@sha256:5f1b98fa02fe396ebce2a0227a0e08309e11792915b9dd2e1f71053d7e7e6666 AS build
WORKDIR /src
COPY go.mod go.sum ./
# Build with exactly the Go toolchain go.mod's `toolchain` line names, not
# whichever Go this base image happens to hold, so go.mod is the one place
# the version is written. The golang image sets GOTOOLCHAIN=local, which
# would ignore go.mod; clearing it lets `go env -w` (saved in Go's env file,
# so later RUN steps see it too) select go.mod's version, which go fetches
# from the module proxy and verifies against the checksum database. An exact
# version rather than GOTOOLCHAIN=auto: auto keeps a newer base image's Go,
# so a base image bump would silently move the images ahead of the CLI.
ENV GOTOOLCHAIN=
RUN tc=$(awk '$1 == "toolchain" { print $2 }' go.mod) && test -n "$tc" && \
    go env -w GOTOOLCHAIN="$tc" && go mod download && go version
COPY . .
# .dockerignore keeps .git out of the context, so the version cannot be read
# here; pass VERSION and REVISION as build args to stamp the binary.
ARG VERSION=dev
ARG REVISION=unknown
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X github.com/jp2195/vantage/buildinfo.Version=${VERSION} -X github.com/jp2195/vantage/buildinfo.Revision=${REVISION}" -o /out/bmp-replay ./cmd/bmp-replay

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/bmp-replay /bmp-replay
ENTRYPOINT ["/bmp-replay"]
